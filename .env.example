# Meta Graph API Credentials (Optional - Mock data used if unconfigured)
META_ACCESS_TOKEN=your_meta_user_access_token_here
IG_BUSINESS_ACCOUNT_ID=17841400000000000

# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pagemetrics

# Application Environment
ENV=development

# CORS Configuration (JSON Array Format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:80"]

# Metrics & Reel Sampling
REEL_SAMPLE_SIZE=12

# Session Security Lifetimes
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Initial Seed User (Optional - Created only if database users table is empty on startup)
INITIAL_USER=agency_admin
INITIAL_PASSWORD=SecureAgencyPassword123!
